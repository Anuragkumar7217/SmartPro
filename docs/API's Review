                        "totalAmount": 90000,
                        "status": "SUBMITTED"
                    },
                    {
                        "rank": 2,
                        "quotationId": "QT_ID",
                        "quotationNumber": "QT-00001",
                        "vendor": "HP India",
                        "totalAmount": 95000,
                        "status": "SUBMITTED"
                    }
                ]
            }
    }

    Expected Business Rules
        ✓ RFQ must not be DRAFT
        ✓ Comparison available for ISSUED and CLOSED RFQs
        ✓ Quotations sorted by totalAmount
        ✓ Rank generated automatically

# SECTION 12 - VENDOR SELECTION

PURCHASE_TEAM ONLY
12.1 Select Vendor
    PATCH /api/quotations/:id/select
    Authorization: Bearer PURCHASE_TEAM Token

    Expected:
        ✓ Selected quotation status becomes SELECTED
        ✓ Remaining quotations become REJECTED
        ✓ Only one quotation remains SELECTED

    Example Response
    json
        {
            "success": true,
            "message": "Vendor selected successfully",
            "data": {
                "quotationNumber": "QT-00002",
                "status": "SELECTED"
            }
        }

    Business Rules
        ✓ RFQ must be CLOSED
        ✓ Only one quotation can be SELECTED
        ✓ Other quotations automatically become REJECTED
        ✓ Selected quotation will be used for Purchase Order generation

